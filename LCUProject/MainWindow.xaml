<Window x:Class="HelperSylas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HelperSylas.ViewModels"
        xmlns:local="clr-namespace:HelperSylas"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Seraphine LCU" Height="800" Width="1200"
        Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <local:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
        <local:RankToColorConverter x:Key="RankColor"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate x:Key="SummonerTemplate" DataType="{x:Type vm:SummonerProfileViewModel}">
            <Grid Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="30" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="100" Height="100">
                            <Ellipse Stroke="#333" StrokeThickness="4"/>
                            <Image Source="{Binding IconUrl}" Margin="8">
                                <Image.Clip>
                                    <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42"/>
                                </Image.Clip>
                            </Image>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{StaticResource SystemAccentColor}" CornerRadius="10" Padding="8,2" Margin="0,0,0,-10">
                                <TextBlock Text="{Binding LevelText}" Foreground="Black" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Cursor="Hand" ToolTip="点击复制">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding CopyNameCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="#333" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding RankText}" Foreground="{Binding RankText, Converter={StaticResource RankColor}}" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding RankLp}" Foreground="{StaticResource TextSecondary}" Margin="10,4,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MatchList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackground}" CornerRadius="6" Margin="0,0,5,10" MinHeight="85" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDetailCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="{Binding ResultBarColor}" RadiusX="2" RadiusY="2"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ResultText}" FontWeight="Bold" Foreground="{Binding ResultColor}" FontSize="15"/>
                                            <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Image Grid.Column="2" Source="{Binding ChampionIconUrl}" Width="52" Height="52" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding KdaText}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="KDA" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CsText}" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding GoldText}" Foreground="#DAA520" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="5" ItemsSource="{Binding ItemUrls}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="34" Height="34" CornerRadius="4" Margin="0,0,4,0" Background="#333">
                                                        <Image Source="{Binding}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="6" Text="{Binding DateText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,40,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Seraphine" FontSize="24" FontWeight="Bold" Margin="24,30,0,30" Foreground="{StaticResource SystemAccentColor}"/>
                <Border Grid.Row="1" Margin="0,20,0,0" Background="#C6D7DB" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GAME STATUS" FontSize="10" FontWeight="Bold" Foreground="#666"/>
                        <TextBlock Text="{Binding GamePhaseText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,40,0,0">
                    <RadioButton Content="主页概览" GroupName="Nav" IsChecked="True" Command="{Binding SwitchTabCommand}" CommandParameter="0" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="战绩查询" GroupName="Nav" Command="{Binding SwitchTabCommand}" CommandParameter="1" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="辅助功能" GroupName="Nav" Command="{Binding SwitchTabCommand}" CommandParameter="2" Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="CONNECTION" FontSize="10" FontWeight="Bold" Foreground="#666"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionDetail}" FontSize="10" Foreground="#666" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Margin="30">
            <!-- 1. 等待动画 -->
            <Grid Visibility="{Binding IsLcConnected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

                    <!-- WebView2 加载动画 -->
                    <wv2:WebView2 x:Name="LoadingWebView" Height="240" Width="240" DefaultBackgroundColor="#121212"/>

                    <!-- 标语 -->
                    <TextBlock FontSize="26" FontWeight="Black" FontStyle="Italic" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColorRaw}" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                        <Run Text="正在 "/>
                        <Run Text="粉碎王冠" Foreground="{StaticResource SystemAccentColor}"/>
                        <Run Text=" ..."/>
                    </TextBlock>
                    <TextBlock Text="搜寻德玛西亚信号 (LCU) 中" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 2. 功能区 -->
            <Grid Visibility="{Binding IsLcConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- 主页 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                    <TextBlock Text="我的主页" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                    <ContentControl Margin="0,50,0,0" Content="{Binding MyProfile}" ContentTemplate="{StaticResource SummonerTemplate}"/>
                </Grid>
                <!-- 查询 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="战绩查询" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="14" BorderThickness="0,0,0,2" Background="{StaticResource CardBackground}" Foreground="{StaticResource TextPrimary}" Tag="Name#Tag">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="      查询      " Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="1" ItemsSource="{Binding SearchTabs}" SelectedItem="{Binding CurrentSearchTab}" Background="Transparent" BorderThickness="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource WinUITabItem}"/>
                        </TabControl.ItemContainerStyle>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}"/>
                                    <Button Command="{Binding CloseCommand}" Content="×" Margin="10,0,-5,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummonerTemplate}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
                <!-- 辅助 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                    <StackPanel>
                        <TextBlock Text="辅助功能" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动接受对局" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="当匹配到对局时，自动点击“接受”按钮。" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAutoAcceptEnabled}">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>