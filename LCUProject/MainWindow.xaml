<Window x:Class="HelperSylas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HelperSylas.ViewModels"
        xmlns:local="clr-namespace:HelperSylas"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HelperSylas" Height="850" Width="1280"
        Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <local:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
        <local:RankToColorConverter x:Key="RankColor"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0" Background="{StaticResource NavBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,40,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="15,30,0,30">
                    <Border Width="4" Height="24" Background="{StaticResource SystemAccentColor}" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColorRaw}" BlurRadius="8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="HelperSylas" FontSize="22" FontWeight="Bold" Margin="12,0,0,0" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,10,0,0" Background="#202226" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GAME STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                        <TextBlock Text="{Binding GamePhaseText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Margin="0,5,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource AccentColorRaw}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,30,0,0">
                    <RadioButton Content="主页概览" GroupName="Nav" IsChecked="True" Tag="{StaticResource IconHome}" Command="{Binding SwitchTabCommand}" CommandParameter="0" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="战绩查询" GroupName="Nav" Tag="{StaticResource IconSearch}" Command="{Binding SwitchTabCommand}" CommandParameter="1" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="辅助功能" GroupName="Nav" Tag="{StaticResource IconTools}" Command="{Binding SwitchTabCommand}" CommandParameter="2" Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionDetail}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="26,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Margin="30">
            <Grid Visibility="{Binding IsLcConnected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                    <wv2:WebView2 x:Name="LoadingWebView" Height="240" Width="240" DefaultBackgroundColor="#1A1D21"/>
                    <TextBlock Text="“ 夺取力量，粉碎王权！ ”" FontSize="28" FontWeight="Black" FontStyle="Italic" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,20,0,15">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColorRaw}" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="搜寻德玛西亚信号 (LCU) 中..." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsLcConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- 主页 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="主页概览" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                    <ContentControl Grid.Row="1" Content="{Binding MyProfile}" ContentTemplate="{StaticResource SummonerTemplate}"/>
                </Grid>

                <!-- 查询页 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="战绩查询" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InputBackground}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextDim}" Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="40,12,10,12" FontSize="14" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                             VerticalContentAlignment="Center" CaretBrush="{StaticResource SystemAccentColor}"
                                             Tag="输入 名字#Tag (如 Faker#KR1)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="查询" Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="1" ItemsSource="{Binding SearchTabs}" SelectedItem="{Binding CurrentSearchTab}" Background="Transparent" BorderThickness="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource WinUITabItem}"/>
                        </TabControl.ItemContainerStyle>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}"/>
                                    <Button Command="{Binding CloseCommand}" Content="×" Margin="10,0,-5,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SummonerTemplate}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>

                <!-- 辅助页 -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                    <StackPanel>
                        <TextBlock Text="辅助功能" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动接受对局" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="当匹配到对局时，自动点击“接受”按钮。" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAutoAcceptEnabled}">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="实用工具" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="重启 LCU 界面" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="客户端卡顿时使用。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding RestartClientCommand}" Content="立即重启" Style="{StaticResource AccentButtonStyle}" Background="#FF4455" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>