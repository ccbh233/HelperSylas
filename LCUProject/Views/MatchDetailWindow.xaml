<Window x:Class="HelperSylas.MatchDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="对局详情" Height="750" Width="1180"
        WindowStartupLocation="CenterOwner" Background="#F3F5F9"
        FontFamily="Segoe UI Variable, Segoe UI">

    <!-- 资源已全部移至 App.xaml，此处留空或删除 -->
    <Window.Resources>
    </Window.Resources>

    <!-- 窗口主体 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息栏 -->
        <Border Grid.Row="0" Background="White" Padding="24" CornerRadius="12" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.03"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- [新增] 顶部元数据 (时间/模式) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,-10,0,0">
                    <TextBlock Text="{Binding GameModeText}" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="{Binding GameDateText}" FontSize="11" Foreground="#D1D5DB" Margin="0,0,5,0"/>
                        <TextBlock Text="|" FontSize="11" Foreground="#E5E7EB"/>
                        <TextBlock Text="{Binding GameDurationText}" FontSize="11" Foreground="#D1D5DB" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 蓝队 -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Team100Result}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource VictoryBrush}"/>
                        <TextBlock Text="蓝队" Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="#6B7280"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Team100Obj}" Foreground="#6B7280" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="BAN" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding Bans100}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Image Source="{Binding}" Style="{StaticResource BanImageStyle}"/>
                                        <Path Data="{StaticResource IconNoBan}" Stroke="#EF4444" StrokeThickness="2" Margin="8" Visibility="{Binding IsEmptyBan, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- VS -->
                <TextBlock Grid.Column="1" Text="VS" FontSize="36" FontWeight="Black" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="40,10"/>

                <!-- 红队 -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <TextBlock Text="红队" Margin="0,0,10,0" VerticalAlignment="Bottom" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Team200Result}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DefeatBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Team200Obj}" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="BAN" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding Bans200}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding}" Style="{StaticResource BanImageStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 表头 -->
                <Grid Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="英雄" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="2" Text="召唤师" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="3" Text="KDA" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="伤害 / 承伤" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="5" Text="综合数据" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="出装" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="7" Text="评分" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </Grid>

                <!-- 蓝队 -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="2" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding Team100}" ItemTemplate="{StaticResource PlayerRowTemplate}"/>
                </Border>

                <!-- 红队 -->
                <Border Background="#FEF2F2" CornerRadius="8" Padding="2">
                    <ItemsControl ItemsSource="{Binding Team200}" ItemTemplate="{StaticResource PlayerRowTemplate}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>