<Application x:Class="HelperSylas.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 1. 颜色资源 -->
        <Color x:Key="AccentColorRaw">#0AC8B9</Color>
        <SolidColorBrush x:Key="SystemAccentColor" Color="{StaticResource AccentColorRaw}"/>
        <SolidColorBrush x:Key="AppBackground" Color="#F0F3F9"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="VictoryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="DefeatBrush" Color="#DC2626"/>

        <!-- 2. 全局字体 -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- 3. [修复] 导航按钮样式 (NavRadioButtonStyle) -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="indicator" Grid.Column="0" Width="4" Height="16" RadiusX="2" RadiusY="2"
                                           Fill="{StaticResource SystemAccentColor}" HorizontalAlignment="Left" 
                                           Visibility="Collapsed" Margin="-12,0,0,0"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. [修复] 选项卡样式 (WinUITabItem) -->
        <Style x:Key="WinUITabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,20,0" Cursor="Hand" Background="Transparent">
                            <ContentPresenter x:Name="Content" ContentSource="Header" HorizontalAlignment="Center" Margin="5,10"/>
                            <Rectangle x:Name="Underline" Height="3" VerticalAlignment="Bottom" Fill="{StaticResource SystemAccentColor}" 
                                       RadiusX="1.5" RadiusY="1.5" Opacity="0" Width="20"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Width" To="40" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. 按钮样式 -->
        <Style x:Key="WinUIButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource WinUIButton}">
            <Setter Property="Background" Value="{StaticResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 6. 图标路径 -->
        <Geometry x:Key="IconSword">M14.5,2.5l-2-2c-0.5-0.5-1.5-0.5-2,0L0.5,10.5c-0.5,0.5-0.5,1.5,0,2l2,2c0.5,0.5,1.5,0.5,2,0l10-10C15,4,15,3,14.5,2.5z</Geometry>
        <Geometry x:Key="IconShield">M8,0L0,3v6c0,5.5,3.8,10.7,8,12c4.2-1.3,8-6.5,8-12V3L8,0z</Geometry>
        <Geometry x:Key="IconEye">M8,2C4,2,0.5,5,0.5,8S4,14,8,14s7.5-3,7.5-6S12,2,8,2z M8,12c-2.2,0-4-1.8-4-4s1.8-4,4-4s4,1.8,4,4S10.2,12,8,12z M8,6C6.9,6,6,6.9,6,8s0.9,2,2,2s2-0.9,2-2S9.1,6,8,6z</Geometry>
        <Geometry x:Key="IconMinion">M8,0C3.6,0,0,3.6,0,8s3.6,8,8,8s8-3.6,8-8S12.4,0,8,0z</Geometry>
        <Geometry x:Key="IconGold">M8,1C4.1,1,1,4.1,1,8s3.1,7,7,7s7-3.1,7-7S11.9,1,8,1z M8,11c-1.7,0-3-1.3-3-3s1.3-3,3-3s3,1.3,3,3S9.7,11,8,11z</Geometry>
        <Geometry x:Key="IconNoBan">M 3,3 L 13,13 M 13,3 L 3,13</Geometry>

        <!-- 7. 卡片样式 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.03"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8. Ban位头像样式 -->
        <Style x:Key="BanImageStyle" TargetType="Image">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Clip">
                <Setter.Value>
                    <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 9. 矢量图标通用样式 -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Application.Resources>
</Application>